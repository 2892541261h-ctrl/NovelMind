{
  "name": "novelmind-desktop",
  "version": "2.0.0",
  "description": "NovelMind Desktop Client — Electron wrapper for the NovelMind web application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "check": "node check-env.js"
  },
  "author": "NovelMind",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.novelmind.desktop",
    "productName": "NovelMind",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend.js",
      "tray.js",
      "frontend-loader.js",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/NovelMind.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
