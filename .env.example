# NovelMind 环境变量示例
# 复制为 .env 后修改（.env 已被 .gitignore 排除，不会提交）

# 后端配置
AI_PROVIDER=mock
AI_MODEL=mock-novel-writer
DATABASE_URL=sqlite:///./novelmind.db

# 前端配置
VITE_API_BASE_URL=http://localhost:8765

# v1.3 AI Provider 环境变量（仅占位，不保存真实值）
OPENAI_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=

# 本地开发标志
NOVELMIND_ENV=local
